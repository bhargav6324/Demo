# Copy to .env.local and adjust. Only VITE_* values reach the browser; never put secrets here.

# "mock" runs entirely in the browser with seeded demo data (no backend/AI needed).
# "real" uses the HTTP clients against the URLs below.
VITE_API_MODE=mock

# Backend & database service (catalog, auth, circulation, analytics). /api/v1 is appended.
VITE_BACKEND_URL=http://localhost:8000

# AI orchestration service (chat). /api/v1 is appended.
VITE_AI_URL=http://localhost:8001

# Mock mode only: simulated network delay in ms so loading states are visible.
VITE_MOCK_LATENCY_MS=350

# One-click demo logins on the sign-in page. Defaults to on in mock mode, off in real mode;
# set to true for a live demo against a backend seeded with the same demo accounts.
# VITE_SHOW_DEMO_LOGINS=true
