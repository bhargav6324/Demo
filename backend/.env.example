LIBRARY_APP_NAME=Smart Library Backend
LIBRARY_ENVIRONMENT=development
LIBRARY_DATABASE_URL=sqlite:///./library.db
# JSON array; origins include scheme and port. No wildcard credential access.
LIBRARY_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional in development: omit to generate a private per-instance key.
# Set a random key of at least 32 bytes in production and for persistent local sessions.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# LIBRARY_JWT_SECRET=<generated-value-goes-in-private-.env-only>
LIBRARY_JWT_ACCESS_TOKEN_MINUTES=60
LIBRARY_JWT_ISSUER=smart-library-backend
LIBRARY_JWT_AUDIENCE=smart-library-api
# Do not place real credentials or tokens in this file.
