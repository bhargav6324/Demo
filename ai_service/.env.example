# --- Backend tool adapter ---
# mock = local fixtures (standalone dev/tests), http = real backend REST API
TOOL_ADAPTER=mock
# Backend API base from BACKEND_API_HANDOFF.md (backend owner's Mac over Tailscale).
# Needs Tailscale running on this machine and the backend bound to its Tailscale IP.
LIBRARY_API_BASE_URL=http://100.83.115.82:8001/api/v1
BACKEND_TIMEOUT_SECONDS=10
# Mock mode only: simulate outages, e.g. get_availability:timeout,search_resources:error  (or *:error)
MOCK_FAILURES=

# --- LLM ---
# gemini = Google Gemini, fake = deterministic offline LLM (tests/demo without a key)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Tried in order when a model's quota is used up (free tier: ~20 requests/day per model)
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash-lite
GEMINI_API_KEY=

# --- Embeddings / RAG ---
# Use EMBEDDING_MODEL=hashing for a fully offline index (lower quality, no model download)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
# Seconds between incremental index refreshes from the backend (updated_since); 0 = off
RAG_REFRESH_SECONDS=300
# Optional (http mode): bearer token the indexer uses to read non-public content.
# Leave empty to index metadata + public content only; other content is read live with the caller's token.
INDEXER_TOKEN=

# --- Orchestrator ---
MAX_TOOL_CALLS=6
ACTION_TTL_SECONDS=300

# --- Service ---
# Where this AI service listens when started with `python -m app`.
# 127.0.0.1 = this PC only. Use your Tailscale IP (e.g. 100.114.163.7) so teammates can reach it.
SERVICE_HOST=127.0.0.1
# 8002 on YOUR machine (the backend uses 8001 on the backend Mac)
SERVICE_PORT=8002
LOG_LEVEL=INFO
